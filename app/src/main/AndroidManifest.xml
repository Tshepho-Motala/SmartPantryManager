<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartPantryManager"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PantryListActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartPantryManager"/>

        <activity
            android:name=".AddEditIngredientActivity"
            android:exported="false"
            android:label="Add/Edit Ingredient"
            android:theme="@style/Theme.SmartPantryManager"/>

        <activity
            android:name=".SuggestedRecipesActivity"
            android:exported="false"
            android:label="Suggested Recipes"
            android:theme="@style/Theme.SmartPantryManager"/>

        <activity
            android:name=".AllRecipesActivity"
            android:exported="false"
            android:label="Recipe Collection"
            android:theme="@style/Theme.SmartPantryManager"/>

        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false"
            android:label="Recipe Detail"
            android:theme="@style/Theme.SmartPantryManager"/>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Theme.SmartPantryManager"/>

    </application>

</manifest>
